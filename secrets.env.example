# ============================================================================
# BIF v1.0 — шаблон секретов копии (фолбэк для технарей).
# Обычный путь — ./install.sh (мастер сам это сгенерирует и провалидирует ключи).
# Вручную: скопируй в copies/<имя>.env, заполни, chmod 600, затем
#   COPY=<имя> docker compose -p bif-<имя> [--profile codex --profile site] up -d --build
#
# Секреты НИКОГДА не попадают в образ или git — только в этот файл на хосте.
# ============================================================================

# ── Обязательное ядро ──
DEEPSEEK_API_KEY=               # platform.deepseek.com
TELEGRAM_BOT_TOKEN=             # @BotFather → /newbot
TELEGRAM_ALLOWED_USERS=         # свой Telegram ID (@userinfobot)
TELEGRAM_HOME_CHANNEL=          # обычно = тот же ID

# ── Опциональные ключи (только под включённые блоки) ──
OPENAI_API_KEY=                 # картинки gpt-image-2 + голос OpenAI + запасной LLM
PERPLEXITY_API_KEY=             # веб-поиск (уровень 2 маршрутизации)
OPENROUTER_API_KEY=             # OpenRouter / Nemotron (/model)

# ── Тумблеры блоков (1=вкл, 0=выкл). Если ключ-блок пуст, ставь 0. ──
# Пусто = авто: WITH_OPENAI/OPENROUTER/PERPLEXITY включатся сами при наличии ключа.
WITH_OPENAI=
WITH_OPENROUTER=
WITH_PERPLEXITY=
WITH_HMEM=1                     # банк памяти + индексация
WITH_VOICE=1                    # локальный STT/TTS (faster-whisper)
WITH_TRACKER=1                  # трекер задач + напоминания
WITH_GOOGLE=0                   # почта/календарь/диск — нужен пост-шаг OAuth
WITH_CODEX=0                    # сложные фоновые задачи (тяжёлый сайдкар, профиль codex)
WITH_SITE=0                     # автодеплой сайта Caddy (профиль site)

# ── Рантайм ──
HERMES_RICH_MESSAGES=1          # rich-формат Telegram (таблицы/длинные сообщения)
# HERMES_GATEWAY_TOKEN=         # авто-генерируется, если пусто
